#!/usr/bin/env python3
"""Keep SCAD sources and local dependencies; ignore everything else."""
import argparse
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parent.parent
PROTECTED = {".git", ".git-local", ".agents", ".codex", ".aws"}
EXCLUDED_SOURCES = {"massage_extension.scad"}
TOKENS = re.compile(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*[\s\S]*?\*/')
STRINGS = re.compile(r'"((?:\\.|[^"\\])*)"')
HEADERS = re.compile(r'\b(?:include|use)\s*<([^>]+)>')
INPUTS = re.compile(r'\b(?:import|surface)\s*\(\s*(?:file\s*=\s*)?("(?:\\.|[^"\\])*"|[^,)]+)')


def uncomment(text):
    return TOKENS.sub(lambda m: m[0] if m[0].startswith('"') else " ", text)


def local_file(source, name):
    if not name or re.match(r"^(?:[A-Za-z]:|/|\\|[a-z]+://)", name):
        return None
    for candidate in (source.parent / name, ROOT / name):
        resolved = candidate.resolve()
        if not resolved.is_relative_to(ROOT):
            continue
        relative = resolved.relative_to(ROOT)
        if set(relative.parts) & PROTECTED:
            continue
        if candidate.is_file():
            return resolved
    return None


def escape_pattern(path):
    return "/" + re.sub(r"([\\*?\[\] #!])", r"\\\1", path.as_posix())


def generate():
    sources = sorted(p.resolve() for p in ROOT.rglob("*.scad")
                     if not set(p.relative_to(ROOT).parts) & PROTECTED)
    dependencies = {}
    excluded = {}
    for source in sources:
        if source.relative_to(ROOT).as_posix() in EXCLUDED_SOURCES:
            excluded[source] = ["excluded by repository selection"]
            dependencies[source] = set()
            continue
        text = uncomment(source.read_text(errors="replace"))
        references = set(HEADERS.findall(text))
        # Also retain literal filenames assigned to variables or mentioned in strings.
        for value in STRINGS.findall(text):
            value = value.replace("\\\\", "\\").replace('\\"', '"')
            if re.search(r"\.[A-Za-z][A-Za-z0-9]{0,9}$", value):
                references.add(value)
        for match in INPUTS.finditer(text):
            value = match[1].strip()
            if value.startswith('"'):
                references.add(value[1:-1].replace("\\\\", "\\").replace('\\"', '"'))
            else:
                # Do not guess at computed or variable input paths.
                excluded.setdefault(source, []).append("unresolved input: " + value)
        dependencies[source] = set()
        for name in sorted(references):
            target = local_file(source, name)
            if target is None:
                excluded.setdefault(source, []).append("missing or external: " + (name or "<empty filename>"))
            else:
                dependencies[source].add(target)
    # Exclude dependents too, so included files cannot use an excluded source.
    while True:
        newly_excluded = {source: ["depends on excluded source: " + str(dep.relative_to(ROOT))
                                  for dep in sorted(deps) if dep in excluded]
                          for source, deps in dependencies.items() if source not in excluded}
        newly_excluded = {source: reasons for source, reasons in newly_excluded.items() if reasons}
        if not newly_excluded:
            break
        excluded.update(newly_excluded)
    assets = {dep for source, deps in dependencies.items() if source not in excluded
              for dep in deps if dep.suffix != ".scad"}
    lines = ["# Generated by: python3 tools/sync-ignore",
             "# Git cannot inspect SCAD contents; regenerate when references change.",
             "# Ignore every file, while allowing directory traversal and SCAD sources.",
             "*", "!*/", "!*.scad", "",
             "# Repository documentation and ignore-rule generator.",
             "!/.gitignore", "!/README.md", "!/tools/sync-ignore", "",
             "# Assets referenced by included SCAD sources."]
    lines += ["!" + escape_pattern(asset.relative_to(ROOT)) for asset in sorted(assets)]
    lines += ["", "# Sources excluded by repository selection."]
    lines += [escape_pattern(Path(name)) for name in sorted(EXCLUDED_SOURCES)]
    lines += ["", "# Sources with missing, external, or unresolved dependencies."]
    for source, reasons in sorted(excluded.items()):
        if source.relative_to(ROOT).as_posix() in EXCLUDED_SOURCES:
            continue
        lines.append("# " + "; ".join(reasons))
        lines.append(escape_pattern(source.relative_to(ROOT)))
    lines += ["", "# Local metadata and private configuration stay excluded."]
    lines += ["/" + name + "/" for name in sorted(PROTECTED)]
    return "\n".join(lines) + "\n", sources, assets, excluded


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Check rules without updating them")
    args = parser.parse_args()
    content, sources, assets, excluded = generate()
    target = ROOT / ".gitignore"
    if args.check:
        if not target.exists() or target.read_text() != content:
            parser.exit(1, ".gitignore is stale; run: python3 tools/sync-ignore\n")
    else:
        target.write_text(content)
    print(f"{len(sources) - len(excluded)} SCAD sources, {len(assets)} referenced assets; "
          f"{len(excluded)} SCAD sources excluded.")
    for source, reasons in sorted(excluded.items()):
        print(f"Excluded {source.relative_to(ROOT)}: {'; '.join(reasons)}")


if __name__ == "__main__":
    main()
